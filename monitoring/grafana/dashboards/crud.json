{
  "uid": "taller-crud-apm",
  "title": "Taller 4 - Rendimiento CRUD",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {"id":1,"type":"timeseries","title":"Peticiones/s por operación","gridPos":{"h":8,"w":12,"x":0,"y":0},"targets":[{"expr":"sum by (operation) (rate(crud_requests_total[1m]))","legendFormat":"{{operation}}"}],"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]},"datasource":{"type":"prometheus","uid":"prometheus"}},
    {"id":2,"type":"timeseries","title":"Latencia p50 / p95 / p99 (ms)","gridPos":{"h":8,"w":12,"x":12,"y":0},"targets":[{"expr":"1000 * histogram_quantile(0.50, sum by (le, operation) (rate(crud_request_duration_seconds_bucket[1m])))","legendFormat":"p50 {{operation}}"},{"expr":"1000 * histogram_quantile(0.95, sum by (le, operation) (rate(crud_request_duration_seconds_bucket[1m])))","legendFormat":"p95 {{operation}}"},{"expr":"1000 * histogram_quantile(0.99, sum by (le, operation) (rate(crud_request_duration_seconds_bucket[1m])))","legendFormat":"p99 {{operation}}"}],"fieldConfig":{"defaults":{"unit":"ms"},"overrides":[]},"datasource":{"type":"prometheus","uid":"prometheus"}},
    {"id":3,"type":"timeseries","title":"Errores por operación (%)","gridPos":{"h":8,"w":12,"x":0,"y":8},"targets":[{"expr":"100 * sum by (operation) (rate(crud_requests_total{status=~\"[45]..\"}[1m])) / clamp_min(sum by (operation) (rate(crud_requests_total[1m])), 0.001)","legendFormat":"{{operation}}"}],"fieldConfig":{"defaults":{"unit":"percent"},"overrides":[]},"datasource":{"type":"prometheus","uid":"prometheus"}},
    {"id":4,"type":"timeseries","title":"Conexiones PostgreSQL","gridPos":{"h":8,"w":12,"x":12,"y":8},"targets":[{"expr":"pg_stat_activity_count","legendFormat":"conexiones"}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"datasource":{"type":"prometheus","uid":"prometheus"}}
  ]
}
